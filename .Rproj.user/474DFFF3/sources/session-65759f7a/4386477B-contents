}

# return a df with alternative in a "band" near the frontier
get_band <- function(df, frontier, tolerance, val) {
  # formate tmp df
  tmp <- data.frame(matrix(nrow = nrow(df), ncol=0))
  tmp$names <- df$names
  tmp$cost <- df$valfunction
  tmp$val <- df[[val]]

  # initialize band
  band <- data.frame(matrix(nrow=0,ncol=ncol(tmp)))

  # for each row in frontier (except last)
  for(i in 1:(nrow(frontier)-1)) {
    # get x and y for row and the next row
    x1=as.numeric(frontier[i, "val"])
    y1=as.numeric(frontier[i, "cost"])
    x2=as.numeric(frontier[i+1, "val"])
    y2=as.numeric(frontier[i+1, "cost"])

    # calculate line
    line <- get_line(x1,y1,x2,y2)
    # get subset of alternatives that fall above that line
    compare <- subset(tmp, val >= x1 & val <= x2)

    # see if they fall within set tolerance to the frontier
    for (i in 1:nrow(compare)) {
      y = get_y(line, as.numeric(compare[i, "val"]))
      cost = as.numeric(compare[i, "cost"])
      if(cost <= y + tolerance) {
        band <- rbind(band, compare[i, ])
      }
    }
  }
  band <- unique(band)
  return(band[order(band$val), ])
}

# get equation for line as slope + intercept
get_line <- function(x1, y1, x2, y2) {
  rise = (y2 - y1)
  run = (x2 - x1)
  slope = rise / run
  intercept = y1 - slope*x1
  return(c(slope, intercept))
}

# helper func to calculate y based on line and x value
get_y <- function(line, x) {
  return(line[1]*x + line[2])
}

#### HELPER CODE FOR VISUALIZING

# draw frontier lines
draw_frontier <- function(df, plot) {
  for(i in 1:(nrow(df)-1)) {
    plot <- plot + geom_segment(x=as.numeric(df[i, "val"]),
                                y=as.numeric(df[i, "cost"]),
                                xend=as.numeric(df[i+1, "val"]),
                                yend=as.numeric(df[i+1, "cost"]))
  }
  return(plot)
}

# draw band lines with cost tolerance
draw_band <- function(df, plot, tolerance) {
  for(i in 1:(nrow(df)-1)) {
    plot <- plot + geom_segment(x=as.numeric(df[i, "val"]) * xoffset,
                                y=as.numeric(df[i, "cost"]) * yoffset,
                                xend=as.numeric(df[i+1, "val"]) * xoffset,
                                yend=as.numeric(df[i+1, "cost"]) * yoffset,
                                linetype="dashed")
  }
  return(plot)
}

