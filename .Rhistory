make_demographics_table <- function(data, vars_cont, vars_cat) {
# Continuous variables: mean (SD)
cont_tbl <- data %>%
summarise(across(
all_of(vars_cont),
list(
mean = ~mean(.x, na.rm = TRUE),
sd   = ~sd(.x, na.rm = TRUE)
),
.names = "{.col}_{.fn}"
)) %>%
tidyr::pivot_longer(everything(),
names_to = c("variable", "stat"),
names_sep = "_",
values_to = "value") %>%
tidyr::pivot_wider(names_from = stat, values_from = value) %>%
mutate(
summary = sprintf("%.2f (%.2f)", mean, sd),
type = "Continuous"
) %>%
select(variable, summary, type)
# Categorical variables: n (%)
cat_tbl <- lapply(vars_cat, function(v) {
tab <- table(data[[v]], useNA = "no")
prop <- prop.table(tab)
data.frame(
variable = paste0(v, "_", names(tab)),
summary  = sprintf("%d (%.1f%%)", as.integer(tab), 100 * as.numeric(prop)),
type = "Categorical"
)
}) %>% bind_rows()
# Combine
bind_rows(cont_tbl, cat_tbl)
}
demographics_df <- make_demographics_table(ddata_cleaned, c("Age", "BMI"), c("Sex", "min_ed", "White", "Asian", "Black", "Ind", "PI",
"Hetero", "Bisexual", "Lesbian", "Questioning", "Queer", "SexOrOther",
"Female", "GNC", "Transmasc", "Male", "GenderOther")) #, "Sexual_Orientation", "Race", "Hispanic_Latino", "max_ed"))
demographics_df %>%
gt() %>%
tab_header(title = "Demographic Summary Statistics") %>%
cols_label(
variable = "Variable",
summary  = "Summary",
type     = "Type"
)
table1_df <- demographics_df %>%
mutate(
# Detect section headers (categorical parent variables)
is_header = !str_detect(variable, "_") & type == "Categorical",
# Indent category levels
row_label = case_when(
is_header ~ variable,
str_detect(variable, "_") ~ paste0("  ", str_replace(variable, ".*?_", "")),
TRUE ~ variable
),
# For continuous variables, keep the variable name as-is
row_label = ifelse(type == "Continuous", variable, row_label),
# Replace summary column name
value = summary
) %>%
select(row_label, value, type, is_header)
t1 <- table1_df %>%
arrange(type, row_label) %>%
gt() %>%
tab_header(
title = md("**Demographic Summary Statistics**")
) %>%
cols_label(
row_label = "",
value = "Total Sample N (%)"
) %>%
# Bold section headers
tab_style(
style = cell_text(weight = "bold"),
locations = cells_body(rows = is_header)
) %>%
# Indent category rows
tab_style(
style = cell_text(indent = px(20)),
locations = cells_body(rows = !is_header & type == "Categorical")
) %>%
cols_align(
align = "center",
columns = value
) %>%
tab_options(
table.font.size = px(14),
data_row.padding = px(6),
heading.align = "center"
) %>%
tab_source_note(
source_note = "SD = standard deviation; IQR = interquartile range"
)
gtsave(
data = t1,
filename = "table1_demographics_new.html"
)
