value.summary$out2.normed <- value.summary$out2 / value.summary$norm_denom
value.summary$out3.normed <- value.summary$out3 / value.summary$norm_denom
value.summary$cost.normed <- value.summary$totcost / value.summary$norm_denom
value.summary$d1.normed <- value.summary$d1 / value.summary$norm_denom
value.summary$d2.normed <- value.summary$d2 / value.summary$norm_denom
pos_ideal <- c(max(value.summary$out1.normed), max(value.summary$out2.normed),
max(value.summary$out3.normed), min(value.summary$cost.normed),
min(value.summary$d1.normed), max(value.summary$d2.normed))
neg_ideal <- c(min(value.summary$out1.normed), min(value.summary$out2.normed),
min(value.summary$out3.normed), max(value.summary$cost.normed),
max(value.summary$d1.normed), min(value.summary$d2.normed))
