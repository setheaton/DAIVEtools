get_distance_metrics <- function(df, outs, targets) {
df <- get_dots(df, outs, targets)
df <- get_euc(df, outs, targets)
return(df)
}
# get the dot product
get_dots <- function(df, outs, targets) {
# initialize empty col
df$dots.raw <- NA
# get target
dot.target <- 0
for (i in 1:length(targets)) {
dot.target <- dot.target + targets[i]^2
}
for(i in 1:nrow(df)) {
vals <- c()
for(j in 1:length(outs)) {
vals <- append(vals, as.numeric(df[[i, outs[j]]]))
}
df[[i, "dots.raw"]] <- abs(calc_dot(vals, targets) - dot.target)
}
#df$dot.prod <- max(df$dots.raw) - df$dots.raw
df$dot.prod <- df$dots.raw
df <- select(df, -dots.raw)
return(df)
}
calc_dot <- function(vals, targets) {
sum <- 0
for (i in 1:length(targets)) {
sum <- sum + (vals[i]*targets[i])
}
return(sum)
}
# function to caluclate euclidian distance then reverse the order
get_euc <- function(df, outs, targets) {
# initialize empty col
df$euc.raw <- NA
# for each row in df, calculate raw euclidian distance from target vector
for(i in 1:nrow(df)) {
vals <- c()
for(j in 1:length(outs)) {
vals <- append(vals, as.numeric(df[[i, outs[j]]]))
}
df[[i, "euc.raw"]] <- calc_distance(vals, targets)
}
df$euc.distance <- df$euc.raw
df <- select(df, -euc.raw)
return(df)
}
# helper func to calculate euclidian distance
calc_distance <- function(vals, targets) {
sum <- 0
for(i in 1:length(vals)) {
sum <- sum + (vals[i] - targets[i])^2
}
return(sqrt(sum))
}
