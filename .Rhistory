value.summary$out2.normed <- value.summary$out2 / value.summary$norm_denom
value.summary$out3.normed <- value.summary$out3 / value.summary$norm_denom
value.summary$cost.normed <- value.summary$totcost / value.summary$norm_denom
value.summary$d1.normed <- value.summary$d1 / value.summary$norm_denom
value.summary$d2.normed <- value.summary$d2 / value.summary$norm_denom
pos_ideal <- c(max(value.summary$out1.normed), max(value.summary$out2.normed),
max(value.summary$out3.normed), min(value.summary$cost.normed),
min(value.summary$d1.normed), max(value.summary$d2.normed))
neg_ideal <- c(min(value.summary$out1.normed), min(value.summary$out2.normed),
min(value.summary$out3.normed), max(value.summary$cost.normed),
max(value.summary$d1.normed), min(value.summary$d2.normed))
value.summary <- get_euc(value.summary, c("out1.normed", "out2.normed",
"out3.normed", "cost.normed",
"d1.normed", "d2.normed"), pos_ideal)
value.summary$positive.distance <- value.summary$euc.distance
value.summary <- get_euc(value.summary, c("out1.normed", "out2.normed",
"out3.normed", "cost.normed",
"d1.normed", "d2.normed"), neg_ideal)
value.summary$negative.distance <- value.summary$euc.distance
value.summary <- select(value.summary, -euc.distance)
value.summary$closeness_coeff <- value.summary$negative.distance /
(value.summary$positive.distance + value.summary$negative.distance)
# get the frontier with closeness coefficients
frontier <- frontier(value.summary, "weighted_sum", "totcost")
tmp <- value.summary[, c("names", "out1", "out2", "out3", "d1", "d2",
"closeness_coeff")]
frontier <- merge(frontier, tmp, by="names")
frontier <- frontier[order(frontier$totcost), ]
frontier
source("~/Documents/DAIVE/VM_Files/VM_workscript_topsis_Scen2.R", echo = TRUE)
value.summary$d1.reversed <- max(value.summary$d1) - value.summary$d1
View(value.summary)
value.summary$d1.scaled.reversed <- max(value.summary$d1.scaled) - value.summary$d1.scaled
View(value.summary)
value.summary$d1.scale.reversed <- max(value.summary$d1.scale) - value.summary$d1.scale
weight_total = 500
weight1 = 100/weight_total
weight2 = 100/weight_total
weight3 = 100/weight_total
weight4 = 100/weight_total
weight5 = 100/weight_total
value.summary$weighted_sum <- weight1*value.summary$out1.scale + weight2*value.summary$out2.scale + weight3*value.summary$out3.scale +
weight4*value.summary$d1.scale.reversed + weight5*value.summary$d2.scale
frontier(value.summary, "weighted_sum", "totcost")
DAIVE_plot(value.summary, "weighted_sum", "totcost")
