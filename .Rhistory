flip.by.names <- function(df, vec, label) {
for(i in 1:length(vec)) {
add.vec <- df[[label]][df$names == vec[i]]
if (i == 1) {
result <- data.frame(add.vec)
} else {
result <- cbind(result, add.vec)
}
}
colnames(result) <- vec
return(result)
}
