get_norm_denom <- function(df, cols) {
# initialize empty col
df$norm_denom <- NA
# for each row in df, calculate raw euclidian distance from target vector
for(i in 1:nrow(df)) {
vals <- c()
for(j in 1:length(cols)) {
vals <- append(vals, as.numeric(df[[i, cols[j]]]))
}
df[[i, "norm_denom"]] <- calc_pythag(vals)
}
return(df)
}
calc_pythag <- function(vals) {
sum <- 0
for(i in 1:length(vals)) {
sum <- sum + (vals[i])^2
}
return(sqrt(sum))
}
