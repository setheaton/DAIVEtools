value.summary <- readRDS("value.summary.jittered.rds")
weight_total = 100 + 100 + 0
weight1 = 100/weight_total
weight2 = 100/weight_total
weight3 = 0/weight_total
#Changed for 3
weight4 = 0
plot_upperbound = 800 # input$plot_upperbound
value.summary$weighted_sum <- weight1*value.summary$out1.scale + weight2*value.summary$out2.scale #+ weight3*value.summary$out3.scale
costs <- expand.grid(A=c(0, 280), B=c(0, 60), C=c(0,80), D=c(0,170), E=c(0,130))
value.summary$totcost = rowSums(costs) + 30
frontier <- frontier(value.summary, "weighted_sum", "totcost")
