max1 = max(outcome.data$out1)
min2 = min(outcome.data$out2)
max2 = max(outcome.data$out2)
min3 = min(outcome.data$out3)
max3 = max(outcome.data$out3)
outcome.data$out1.scale = (outcome.data$out1 - min1)/(max1-min1)
outcome.data$out1.scale[outcome.data$out1.scale < 0] = 0
outcome.data$out1.scale[outcome.data$out1.scale > 1] = 1
outcome.data$out2.scale = (outcome.data$out2 - min2)/(max2-min2)
outcome.data$out2.scale[outcome.data$out2.scale < 0] = 0
outcome.data$out2.scale[outcome.data$out2.scale > 1] = 1
outcome.data$out3.scale = (outcome.data$out3 - min3)/(max3-min3)
outcome.data$out3.scale[outcome.data$out3.scale < 0] = 0
outcome.data$out3.scale[outcome.data$out3.scale > 1] = 1
# For making the value summary
value.summary = codes[,2:6]
value.summary$out1 = NA
value.summary$out2 = NA
value.summary$out3 = NA
value.summary$out1.scale = NA
value.summary$out2.scale = NA
value.summary$out3.scale = NA
#Seth, the below for loop is selecting out the outcome data for a given intervention version and calculating the mean
### Note: I changed this to include the 1:5, ASK!
for (i in 1:32) {
sub = match_df(outcome.data, value.summary[i,1:5])
value.summary$out1[i] = mean(sub$out1)
value.summary$out2[i] = mean(sub$out2)
value.summary$out3[i] = mean(sub$out3)
value.summary$out1.scale[i] = mean(sub$out1.scale)
value.summary$out2.scale[i] = mean(sub$out2.scale)
value.summary$out3.scale[i] = mean(sub$out3.scale)
}
# make the outcome columns numeric
value.summary$out1 <- as.numeric(value.summary$out1)
value.summary$out2 <- as.numeric(value.summary$out2)
value.summary$out3 <- as.numeric(value.summary$out3)
value.summary.new$out3.scale - value.summary$out3.scale
# Bayesian regression model for outcome 2
out2.model = brm(Y2 ~ (A + B + C + D + E)^5, data = mdata, prior = prior("normal(0,2)"), chains=4)
# Bayesian regression model for outcome 3
out3.model = brm(Y3 ~ (A + B + C + D + E)^5, data = mdata, prior = prior("normal(0,2)"), chains=4)
