outcome.data.high = rename(outcome.data.high, Helpful = V3)
#Convert treatment seeking to probability
outcome.data.high$probtx = plogis(outcome.data.high$ever_tx)
#mcmc_areas_ridges(Outcome_data, pars = c("change_sum", "ETscale", "Helpful"))
#Scale outcomes
#minCS = hdi(x=Outcome_data$change_sum, credMass=0.999)[1]
#maxCS = hdi(x=Outcome_data$change_sum, credMass=0.999)[2]
minCS = min(outcome.data.high$change_sum)
maxCS = max(outcome.data.high$change_sum)
minET = hdi(outcome.data.high$ever_tx, credMass=0.999)[1]
maxET = hdi(outcome.data.high$ever_tx, credMass=0.999)[2]
#minH = hdi(x=Outcome_data$Helpful, credMass=0.999)[1]
#maxH = hdi(x=Outcome_data$Helpful, credMass=0.999)[2]
minH = min(outcome.data.high$Helpful)
maxH = max(outcome.data.high$Helpful)
outcome.data.high$CSscale = (outcome.data.high$change_sum - minCS)/(maxCS-minCS)
outcome.data.high$CSscale[outcome.data.high$CSscale < 0] = 0
outcome.data.high$CSscale[outcome.data.high$CSscale > 1] = 1
outcome.data.high$ETscale = (outcome.data.high$ever_tx - minET)/(maxET-minET)
outcome.data.high$ETscale[outcome.data.high$ETscale < 0] = 0
outcome.data.high$ETscale[outcome.data.high$ETscale > 1] = 1
